and      A    L  1100RRR110mmmeee  (An),(An)+,-(An),(d16,An),(d8,An,Xi),abs.W,abs.L  -  AndDnEa  # CFPRM ch. 4 AND, p. 4-9
mulu     A    W  1100RRR011mmmeee  data  -  MuluW       # CFPRM ch. 4 MULU, p. 4-57
muls     A    W  1100RRR111mmmeee  data  -  MulsW       # CFPRM ch. 4 MULS, p. 4-55

# ---- line D: ADD, ADDX, ADDA --------------------------------------------------------------------------
add      A    L  1101RRR010mmmeee  all  -  AddEaDn      # CFPRM ch. 4 ADD, p. 4-3
add      A    L  1101RRR110mmmeee  (An),(An)+,-(An),(d16,An),(d8,An,Xi),abs.W,abs.L  -  AddDnEa  # CFPRM ch. 4 ADD, p. 4-3
addx     A    L  1101RRR110000rrr  none  -  Addx        # CFPRM ch. 4 ADDX, p. 4-7
adda     A    L  1101RRR111mmmeee  all  -  Adda         # CFPRM ch. 4 ADDA, p. 4-4

# ---- line E: shifts (longword; i/r bit 5; count 0 means 8) --------------------------------------------
asr      A    L  1110qqq010000rrr  none  -  AsrImm      # CFPRM ch. 4 ASR, p. 4-12
asr      A    L  1110RRR010100rrr  none  -  AsrReg      # CFPRM ch. 4 ASR, p. 4-12
asl      A    L  1110qqq110000rrr  none  -  AslImm      # CFPRM ch. 4 ASL, p. 4-12
asl      A    L  1110RRR110100rrr  none  -  AslReg      # CFPRM ch. 4 ASL, p. 4-12
lsr      A    L  1110qqq010001rrr  none  -  LsrImm      # CFPRM ch. 4 LSR, p. 4-45
lsr      A    L  1110RRR010101rrr  none  -  LsrReg      # CFPRM ch. 4 LSR, p. 4-45
lsl      A    L  1110qqq110001rrr  none  -  LslImm      # CFPRM ch. 4 LSL, p. 4-45
lsl      A    L  1110RRR110101rrr  none  -  LslReg      # CFPRM ch. 4 LSL, p. 4-45

# ---- line F: FPU (not on this chip), cache, debug, CAU ------------------------------------------------
# Every FPU arithmetic, FMOVE, FMOVEM and FMOVE-to/from-FPcr instruction is this opword plus a command
# word; the EA union is that of the ch. 7 tables (no #imm, so the command word never changes the length).
fpu      Fpu  -  1111001000mmmeee  Dn,An,(An),(An)+,-(An),(d16,An),(d16,PC)  ext  FpuOp  # CFPRM ch. 7 FABS p. 7-12, FMOVE p. 7-25, FMOVE to FPIAR p. 7-31, FMOVEM p. 7-34; ch. 9 p. 9-17
fbcc     Fpu  W  1111001010pppppp  none  w  Fbcc         # CFPRM ch. 7 FBcc, p. 7-15 (FNOP is FBF.W #0, p. 7-39)
fbcc     Fpu  L  1111001011pppppp  none  l  Fbcc         # CFPRM ch. 7 FBcc, p. 7-15
fsave    Fpu  -  1111001100mmmeee  (An),(d16,An)  -  Fsave             # CFPRM ch. 8 FSAVE, p. 8-6
frestore Fpu  -  1111001101mmmeee  (An),(d16,An),(d16,PC)  -  Frestore # CFPRM ch. 8 FRESTORE, p. 8-4
intouch  B    -  1111010000101rrr  none  -  Intouch      # CFPRM ch. 8 INTOUCH, p. 8-8
cpushl   A    -  11110100kk101rrr  none  -  Cpushl       # CFPRM ch. 8 CPUSHL, p. 8-2 (cache 00 is INTOUCH)
wddata   A    B  1111101100mmmeee  (An),(An)+,-(An),(d16,An),(d8,An,Xi),abs.W,abs.L  -  Wddata  # CFPRM ch. 4 WDDATA, p. 4-87
wddata   A    W  1111101101mmmeee  (An),(An)+,-(An),(d16,An),(d8,An,Xi),abs.W,abs.L  -  Wddata  # CFPRM ch. 4 WDDATA, p. 4-87
wddata   A    L  1111101110mmmeee  (An),(An)+,-(An),(d16,An),(d8,An,Xi),abs.W,abs.L  -  Wddata  # CFPRM ch. 4 WDDATA, p. 4-87
wdebug   A    L  1111101111mmmeee  (An),(d16,An)  ext  Wdebug  # CFPRM ch. 8 WDEBUG, p. 8-18 (extension word 0x0003)
# guess: neither manual gives the coprocessor opword encoding. RM 26.3.2 names cp0ld.l/cp0st.l with
# <ea> in {Rn, (An), -(An), (An)+, (d16,An)} and a 9-bit command; the bit layout below (coprocessor 0,
# bit 8 store, bits 7-6 = 10 longword, then an extension word holding Rn, ET and the command) is what the
# GNU assembler emits for -mcpu=54418, the only available source for it.
cp0ld    Cau  L  1111110010mmmeee  Dn,An,(An),(An)+,-(An),(d16,An)  ext  Cp0ld  # CFPRM: not listed; RM 26.3.2, Table 26-5
cp0st    Cau  L  1111110110mmmeee  Dn,An,(An),(An)+,-(An),(d16,An)  ext  Cp0st  # CFPRM: not listed; RM 26.3.2, Table 26-5
