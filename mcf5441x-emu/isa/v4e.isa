# ---- line 9: SUB, SUBX, SUBA --------------------------------------------------------------------------
sub      A    L  1001RRR010mmmeee  all  -  SubEaDn      # CFPRM ch. 4 SUB, p. 4-76
sub      A    L  1001RRR110mmmeee  (An),(An)+,-(An),(d16,An),(d8,An,Xi),abs.W,abs.L  -  SubDnEa  # CFPRM ch. 4 SUB, p. 4-76
subx     A    L  1001RRR110000rrr  none  -  Subx        # CFPRM ch. 4 SUBX, p. 4-80
suba     A    L  1001RRR111mmmeee  all  -  Suba         # CFPRM ch. 4 SUBA, p. 4-77

# ---- line A: EMAC, MOV3Q ------------------------------------------------------------------------------
# MAC and MSAC share each opword; extension bit 8 selects MSAC. Extension bits 1-0 select the EMAC_B
# dual-accumulate forms, which this core does not implement (RM ch. 5); the opword is the same.
mac      Emac -  1010RRR0ax00rrrr  none  ext  Mac      # CFPRM ch. 6 MAC, p. 6-4; MSAC, p. 6-29
mac      Emac L  1010RRR0axmmmeee  (An),(An)+,-(An),(d16,An)  ext  MacLoad  # CFPRM ch. 6 MAC with load, p. 6-7; MSAC with load, p. 6-31
