move     Emac L  10100aa1000100yy  none  -  MoveAccAcc             # CFPRM ch. 6 MOVE ACC to ACC, p. 6-20
move     Emac L  10100aa11000rrrr  none  -  MoveFromAcc            # CFPRM ch. 6 MOVE from ACC, p. 6-15
movclr   Emac L  10100aa11100rrrr  none  -  Movclr                 # CFPRM ch. 6 MOVCLR, p. 6-12
move     Emac L  1010100100mmmeee  Dn,An,#imm  -  MoveToMacsr      # CFPRM ch. 6 MOVE to MACSR, p. 6-25
move     Emac L  101010011000rrrr  none  -  MoveFromMacsr          # CFPRM ch. 6 MOVE from MACSR, p. 6-18
move     Emac L  1010100111000000  none  -  MoveMacsrCcr           # CFPRM ch. 6 MOVE MACSR to CCR, p. 6-21
move     Emac L  1010101100mmmeee  Dn,An,#imm  -  MoveToAccext01   # CFPRM ch. 6 MOVE to ACCext01, p. 6-23
move     Emac L  101010111000rrrr  none  -  MoveFromAccext01       # CFPRM ch. 6 MOVE from ACCext01, p. 6-16
move     Emac L  1010110100mmmeee  Dn,An,#imm  -  MoveToMask       # CFPRM ch. 6 MOVE to MASK, p. 6-26
move     Emac L  101011011000rrrr  none  -  MoveFromMask           # CFPRM ch. 6 MOVE from MASK, p. 6-19
move     Emac L  1010111100mmmeee  Dn,An,#imm  -  MoveToAccext23   # CFPRM ch. 6 MOVE to ACCext23, p. 6-24
move     Emac L  101011111000rrrr  none  -  MoveFromAccext23       # CFPRM ch. 6 MOVE from ACCext23, p. 6-17
mov3q    B    L  1010qqq101mmmeee  Dn,An,(An),(An)+,-(An),(d16,An),(d8,An,Xi),abs.W,abs.L  -  Mov3q  # CFPRM ch. 4 MOV3Q, p. 4-46

# ---- line B: CMP, CMPA, EOR ---------------------------------------------------------------------------
