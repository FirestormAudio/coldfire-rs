mvs      B    B  0111RRR100mmmeee  all  -  Mvs         # CFPRM ch. 4 MVS, p. 4-59
mvs      B    W  0111RRR101mmmeee  all  -  Mvs          # CFPRM ch. 4 MVS, p. 4-59
mvz      B    B  0111RRR110mmmeee  all  -  Mvz         # CFPRM ch. 4 MVZ, p. 4-60
mvz      B    W  0111RRR111mmmeee  all  -  Mvz          # CFPRM ch. 4 MVZ, p. 4-60

# ---- line 8: OR, DIV.W --------------------------------------------------------------------------------
or       A    L  1000RRR010mmmeee  data  -  OrEaDn      # CFPRM ch. 4 OR, p. 4-66
or       A    L  1000RRR110mmmeee  (An),(An)+,-(An),(d16,An),(d8,An,Xi),abs.W,abs.L  -  OrDnEa  # CFPRM ch. 4 OR, p. 4-66
divu     Div  W  1000RRR011mmmeee  data  -  DivuW       # CFPRM ch. 4 DIVU, p. 4-34
