cmp      B    B  1011RRR000mmmeee  data  -  Cmp         # CFPRM ch. 4 CMP, p. 4-28 (.B from ISA_B)
cmp      B    W  1011RRR001mmmeee  all  -  Cmp          # CFPRM ch. 4 CMP, p. 4-28 (.W from ISA_B)
cmp      A    L  1011RRR010mmmeee  all  -  Cmp          # CFPRM ch. 4 CMP, p. 4-28
cmpa     B    W  1011RRR011mmmeee  all  -  Cmpa         # CFPRM ch. 4 CMPA, p. 4-29 (.W from ISA_B)
cmpa     A    L  1011RRR111mmmeee  all  -  Cmpa         # CFPRM ch. 4 CMPA, p. 4-29
eor      A    L  1011RRR110mmmeee  Dn,(An),(An)+,-(An),(d16,An),(d8,An,Xi),abs.W,abs.L  -  Eor  # CFPRM ch. 4 EOR, p. 4-35

# ---- line C: AND, MUL.W -------------------------------------------------------------------------------
